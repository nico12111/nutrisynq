# =============================================================================
# Polymarket Copy-Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file!

# --- Polygon RPC ---
# Use a reliable RPC provider (Alchemy, Infura, QuickNode, etc.)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_WSS=wss://polygon-bor-rpc.publicnode.com

# --- Polymarket CLOB API ---
# These are auto-generated by: python -m src.main setup
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Wallet ---
# Your Polygon wallet private key (for signing orders)
# WARNING: Keep this secret! Never share or commit this value.
PRIVATE_KEY=

# Your Polymarket proxy wallet address (shown on polymarket.com/settings)
# This is the "funder" that holds your USDC balance.
FUNDER_ADDRESS=

# Signature type: 1 = Magic Link (email/Google login), 2 = Gnosis Safe (most common)
# If you logged in via email/Google on Polymarket: use 1
# Otherwise: use 2
SIGNATURE_TYPE=1

# --- Bot Settings ---
# dry_run = true means NO real trades are executed (paper trading mode)
DRY_RUN=true
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
