# =============================================================================
# Polymarket Copy-Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file!

# --- Polygon RPC ---
# Use a reliable RPC provider (Alchemy, Infura, QuickNode, etc.)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_WSS=wss://polygon-bor-rpc.publicnode.com

# --- Polymarket CLOB API ---
# Your Polymarket API credentials
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Wallet ---
# Your Polygon wallet private key (for executing trades)
# WARNING: Keep this secret! Never share or commit this value.
PRIVATE_KEY=

# --- Bot Settings ---
# dry_run = true means NO real trades are executed (paper trading mode)
DRY_RUN=true
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
